{
  "autoMemoryEnabled": false,
  "effortLevel": "high",
  "model": "opus",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] },
      { "matcher": "startup", "hooks": [{ "type": "command", "command": "polix update --hook", "timeout": 180 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "polix hook claude", "timeout": 900 }] }
    ]
  }
}
